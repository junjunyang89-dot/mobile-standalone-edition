{
  "name": "mobile-standalone-edition",
  "version": "1.0.0",
  "description": "Mobile automation testing framework with Electron + Vue 3",
  "main": "dist-electron/main/index.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:backend": "cd /Volumes/MOVESPEED/qa_coding/mobile-standalone-backend && mvn spring-boot:run",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev\"",
    "dev:electron": "concurrently \"npm run dev:backend\" \"vite\" \"wait-on http://127.0.0.1:3080 http://localhost:5173 && electron .\"",
    "dev:app": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && electron-builder",
    "build:win": "vite build && electron-builder --win",
    "build:mac": "vite build && electron-builder --mac",
    "build:mac:dmg": "vite build && electron-builder --mac --config.mac.target=dmg",
    "build:mac:zip": "vite build && electron-builder --mac --config.mac.target=zip",
    "build:installer": "node scripts/build-installer.mjs mac",
    "build:installer:mac": "node scripts/build-installer.mjs mac",
    "build:installer:win": "node scripts/build-installer.mjs win",
    "build:server": "tsc -p server/tsconfig.json",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev:server\" \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:pack": "electron-builder",
    "postinstall": "electron-builder install-app-deps && electron-rebuild -f -w better-sqlite3 usb",
    "rebuild": "electron-rebuild -f -w better-sqlite3 usb --version=$(node -p \"require('electron/package.json').version\")",
    "rebuild:all": "electron-rebuild -f -w better-sqlite3 usb"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "better-sqlite3": "^11.2.0",
    "body-parser": "^1.20.2",
    "chokidar": "^3.6.0",
    "cors": "^2.8.5",
    "echarts": "^5.5.0",
    "element-plus": "^2.5.12",
    "express": "^4.18.2",
    "fs-extra": "^11.2.0",
    "lowdb": "^7.0.1",
    "pinia": "^2.1.7",
    "usb": "^2.12.0",
    "uuid": "^9.0.1",
    "vue": "^3.4.21",
    "vue-echarts": "^6.6.9",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.30",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-vue": "^5.0.4",
    "concurrently": "^8.2.2",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.3",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vue-tsc": "^1.8.27",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.mobile.standalone.edition",
    "productName": "Mobile Standalone Edition",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "backend",
        "filter": ["*.jar"]
      },
      {
        "from": "resources/control-plane.json",
        "to": "control-plane.json"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/main/index.js.map",
      "!dist-electron/preload/index.js.map",
      "node_modules/**/*",
      "!node_modules/**/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!node_modules/**/{test,__tests__,tests,powered-test,example,examples}",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.map"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/usb/**/*"
    ],
    "asar": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
